rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow only authenticated users with verified email to read all collections
    // Allow admins to write to all collections
    match /students/{document} {
      allow read: if request.auth != null && request.auth.token.email_verified;
      allow write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;
    }

    // Full parent records: admins, and each parent their own record.
    // Everyone else reads /parentDirectory, which leaves out the contact
    // information of parents who haven't confirmed it with the update form.
    match /parents/{document} {
      allow read: if request.auth != null && request.auth.token.email_verified
        && (request.auth.token.admin == true
          || resource.data.email == request.auth.token.email.lower());
      allow write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;
    }

    // Written only by the syncParentDirectory function
    match /parentDirectory/{document} {
      allow read: if request.auth != null && request.auth.token.email_verified;
      allow write: if false;
    }

    match /staff/{document} {
      allow read: if request.auth != null && request.auth.token.email_verified;
      allow write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;
    }

    match /classes/{document} {
      allow read: if request.auth != null && request.auth.token.email_verified;
      allow write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;
    }

    match /committees/{document} {
      allow read: if request.auth != null && request.auth.token.email_verified;
      allow write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;

      match /members/{memberId} {
        allow read: if request.auth != null && request.auth.token.email_verified;
        allow write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;
      }
    }

    match /workflows/{document} {
      allow read, write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;

      match /participants/{participantId} {
        allow read, write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;
      }
    }

    match /actionLogs/{document} {
      allow read, write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;
    }

    match /tokens/{document} {
      allow read, write: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;
    }

    match /feedback/{document} {
      // Parents send feedback through the submitFeedback function, which sets the
      // sender and status itself: clients can't create feedback directly.
      // Only admins can read, update, and delete feedback
      allow read, update, delete: if request.auth != null && request.auth.token.email_verified && request.auth.token.admin == true;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}