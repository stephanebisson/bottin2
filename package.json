{
  "name": "b2",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "test": "npm run lint && npm run test:run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "deploy": "npm run build:prod && firebase deploy --only hosting",
    "deploy:all": "npm run build:prod && firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:preview": "npm run build:prod && firebase hosting:channel:deploy preview",
    "backup:prod": "NODE_ENV=production node scripts/backup-firestore.js",
    "backup:dev": "NODE_ENV=development node scripts/backup-firestore.js",
    "restore:prod": "NODE_ENV=production node scripts/restore-firestore.js",
    "restore:dev": "NODE_ENV=development node scripts/restore-firestore.js",
    "restore:prod:dry-run": "NODE_ENV=production node scripts/restore-firestore.js --dry-run",
    "restore:dev:dry-run": "NODE_ENV=development node scripts/restore-firestore.js --dry-run",
    "backup:emulator": "firebase emulators:export backups/$(date +%Y-%m-%d-%H%M%S)-emulator-backup && echo '✅ Emulator data exported to backups/'",
    "emulator:start": "firebase emulators:start",
    "emulator:import": "firebase emulators:start --import=./backups/latest-backup 2>/dev/null || (echo '⚠️  No latest-backup found, starting fresh emulator' && firebase emulators:start)",
    "restore:emulator": "echo '📋 Available backups:' && ls -1 backups/ 2>/dev/null || echo 'No backups found' && echo 'To restore: firebase emulators:start --import=./backups/BACKUP_NAME'",
    "setup:admin": "node scripts/createInitialAdmin.js",
    "admin:grant": "node scripts/manageAdmin.js grant",
    "admin:revoke": "node scripts/manageAdmin.js revoke",
    "admin:list": "node scripts/manageAdmin.js list",
    "admin:status": "node scripts/manageAdmin.js status",
    "admin:auto": "NODE_ENV=development node scripts/autoSetupAdmin.js",
    "dev:auto": "node scripts/devStart.js",
    "export:staff:dev": "NODE_ENV=development node scripts/export-staff.js",
    "export:staff:prod": "NODE_ENV=production node scripts/export-staff.js",
    "export:staff:dev:dry-run": "NODE_ENV=development node scripts/export-staff.js --dry-run",
    "export:staff:prod:dry-run": "NODE_ENV=production node scripts/export-staff.js --dry-run",
    "users:list:dev": "NODE_ENV=development node scripts/list-users.js",
    "users:list:prod": "NODE_ENV=production node scripts/list-users.js",
    "users:list:dev:verified": "NODE_ENV=development node scripts/list-users.js --verified",
    "users:list:prod:verified": "NODE_ENV=production node scripts/list-users.js --verified",
    "users:list:dev:unverified": "NODE_ENV=development node scripts/list-users.js --unverified",
    "users:list:prod:unverified": "NODE_ENV=production node scripts/list-users.js --unverified",
    "users:unauthorized:dev": "NODE_ENV=development node scripts/find-unauthorized-accounts.js",
    "users:unauthorized:prod": "NODE_ENV=production node scripts/find-unauthorized-accounts.js",
    "tokens:cleanup:dev": "NODE_ENV=development node scripts/remove-expired-tokens.js",
    "tokens:cleanup:prod": "NODE_ENV=production node scripts/remove-expired-tokens.js",
    "tokens:cleanup:dev:dry-run": "NODE_ENV=development node scripts/remove-expired-tokens.js --dry-run",
    "tokens:cleanup:prod:dry-run": "NODE_ENV=production node scripts/remove-expired-tokens.js --dry-run"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.6",
    "@mdi/font": "7.4.47",
    "dotenv": "^16.6.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.42",
    "vue-banana-i18n": "^2.3.0",
    "vuetify": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "abortcontroller-polyfill": "^1.7.8",
    "baseline-browser-mapping": "^2.11.20",
    "eslint": "^9.39.5",
    "eslint-config-vuetify": "^4.7.2",
    "jsdom": "^25.0.1",
    "sass-embedded": "^1.103.1",
    "sharp": "^0.34.5",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.14.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-layouts-next": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-router": "^4.6.4"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
